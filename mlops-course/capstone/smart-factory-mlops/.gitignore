# =============================================================================
# .gitignore — Smart Factory MLOps Capstone
# -----------------------------------------------------------------------------
# 原則：資料與模型產物走 DVC / registry，不進 Git；只保留目錄佔位 .gitkeep。
# =============================================================================

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- 環境與密鑰（絕不上 Git）------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- MLflow 產物 -------------------------------------------------------------
mlruns/
mlartifacts/

# --- 監控報告產物（make monitor 產出的 Evidently HTML）-----------------------
monitoring/reports/

# --- DVC pipeline 產物（reports/metrics.json 由 evaluate 階段產生）------------
reports/

# --- 模型產物（DVC / registry 管理）-----------------------------------------
# 注意：用 /models/ 錨定根目錄，否則會誤殺原始碼 src/models/。
/models/
*.onnx
*.pt
*.pth
*.pkl
*.joblib

# --- 資料庫 / 序列化大檔 -----------------------------------------------------
*.db
*.sqlite
*.parquet

# --- 資料（DVC 追蹤；保留目錄結構的 .gitkeep）-------------------------------
# 用 dir/* 忽略「內容」而非「目錄本身」，否則 .gitkeep 的 !negation 無法生效
# （git 無法 re-include 已被排除的父目錄底下的檔案）。
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# --- Feast 線上 store 本地檔 -------------------------------------------------
feature_repo/data/*
!feature_repo/data/.gitkeep
feature_repo/*.db

# --- DVC 暫存 ----------------------------------------------------------------
/.dvc/cache
/.dvc/tmp

# --- Terraform（M5 IaC）------------------------------------------------------
# ★ terraform.tfstate 會以「明文」保存所有變數值,包含被標成 sensitive 的密碼。
#   sensitive 只影響 CLI 輸出顯示,不會加密 state 檔本身——commit 它等同外洩憑證。
#   正式環境請改用遠端 state（見 infra/terraform/README.md 的 backend "s3" 區塊）。
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfplan
# 示意 apply 產出的描述檔,可重新生成
infra/terraform/.generated/
# .tfvars 可能含環境細節;保留 .example 供參考
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# --- 編輯器 / 系統 -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
